### Ansible ###
*.retry
.ansible_cache
.ansible

### Python ###
# Byte-compiled / optimized / DLL files
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class

### Molecule ###
.tox
.cache
.molecule
.vagrant

#venv
venv
.ansible/

# Role symlinks that Molecule needs for a local run:
# molecule/<scenario>/roles/<namespace>.<role> -> the repository root.
# They must never be committed. They make a self-referential tree, and
# ansible-lint follows it: a lint run goes from seconds to over ten minutes.
molecule/*/roles/
