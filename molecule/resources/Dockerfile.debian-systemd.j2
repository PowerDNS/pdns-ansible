# Molecule managed

FROM {{ item.image }}

ENV container docker
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends systemd python3 python3-pip python3-apt sudo adduser bash net-tools iproute2 procps && \
    rm -Rf /usr/share/doc && \
    rm -Rf /usr/share/man && \
    apt-get clean

RUN rm -f /lib/systemd/system/multi-user.target.wants/* \
    /etc/systemd/system/*.wants/* \
    /lib/systemd/system/local-fs.target.wants/* \
    /lib/systemd/system/sockets.target.wants/*udev* \
    /lib/systemd/system/sockets.target.wants/*initctl* \
    /lib/systemd/system/sysinit.target.wants/systemd-tmpfiles-setup* \
    /lib/systemd/system/systemd-update-utmp*

# Disable requiretty.
RUN sed -i -e 's/^\(Defaults\s*requiretty\)/#--- \1/'  /etc/sudoers

# Create the `ansible` connection user with passwordless sudo.
#
# The sudoers drop-in replaces editing the distribution's default %wheel or %sudo
# line, which differs per family and is silently ineffective if that line ever
# changes.
#
# The account also gets a password and has every aging field disabled. Without
# them the shadow entry is locked (`!!`) with distribution-dependent aging, and
# pam_unix's account management then reports "Authentication service cannot
# retrieve authentication info", which makes every sudo call fail - observed on
# Oracle Linux 9 while Rocky Linux 9 with the same PAM configuration was fine.
ENV ANSIBLE_USER=ansible
RUN set -xe && \
    groupadd -r ${ANSIBLE_USER} && \
    useradd -m -g ${ANSIBLE_USER} ${ANSIBLE_USER} && \
    printf '%s ALL=(ALL) NOPASSWD:ALL\n' "${ANSIBLE_USER}" > /etc/sudoers.d/${ANSIBLE_USER} && \
    chmod 0440 /etc/sudoers.d/${ANSIBLE_USER} && \
    printf '%s:%s\n' "${ANSIBLE_USER}" "${ANSIBLE_USER}" | chpasswd && \
    chage -M -1 -m 0 -I -1 -E -1 ${ANSIBLE_USER}

VOLUME [ "/sys/fs/cgroup", "/tmp", "/run" ]

CMD [ "/lib/systemd/systemd" ]
