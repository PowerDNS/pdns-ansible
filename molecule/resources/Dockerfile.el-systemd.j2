# Molecule managed

FROM {{ item.image }}

ENV container docker

# The `retries` option of dnf covers the download of a package, not the refresh
# of the repository metadata, and these images set `skip_if_unavailable=False`,
# so a mirrorlist that momentarily answers without any URL fails the whole build
# with "Cannot prepare internal mirrorlist". Retry the refresh and the
# installation together, and still fail once the attempts are exhausted.
#
# The package list is the minimum these images lack. `bash`, `awk` and `grep`
# come with every base image; `ps` is only absent on Rocky, and nothing here
# uses it, since the tests query services and sockets rather than processes.
# `iproute` stays because `ss` is what the socket assertions of testinfra call,
# `python3` and `sudo` because Oracle Linux 8 ships neither, and `hostname`
# because the MySQL and PostgreSQL tests derive the database name from
# `hostname -s` and Oracle Linux 8 has no such command. Nothing runs `pip`
# inside a container, so `python3-pip` is gone as well.
#
# `acl` is not optional here: Molecule connects as the unprivileged `ansible`
# account, so a task with `become_user` performs an unprivileged to unprivileged
# escalation, and Ansible needs setfacl to hand the temporary files to the target
# account. Only Oracle Linux 8 ships it in the base image; without it the task
# fails with "Failed to set permissions on the temporary files Ansible needs to
# create when becoming an unprivileged user".
RUN ok=0; \
    for i in 1 2 3; do \
        dnf makecache && \
        dnf install -y systemd python3 sudo iproute acl ca-certificates hostname && \
        { ok=1; break; }; \
        echo "dnf attempt ${i} failed, retrying in 15 seconds"; \
        sleep 15; \
    done; \
    [ "${ok}" -eq 1 ] || exit 1; \
    rm -Rf /usr/share/doc && \
    rm -Rf /usr/share/man && \
    dnf clean all

RUN cd /lib/systemd/system/sysinit.target.wants/; \
    for i in *; do [ $i = systemd-tmpfiles-setup.service ] || rm -f $i; done

RUN rm -f /lib/systemd/system/multi-user.target.wants/* \
    /etc/systemd/system/*.wants/* \
    /lib/systemd/system/local-fs.target.wants/* \
    /lib/systemd/system/sockets.target.wants/*udev* \
    /lib/systemd/system/sockets.target.wants/*initctl* \
    /lib/systemd/system/basic.target.wants/* \
    /lib/systemd/system/anaconda.target.wants/*

# Disable requiretty.
RUN sed -i -e 's/^\(Defaults\s*requiretty\)/#--- \1/'  /etc/sudoers

# Approve local accounts before the shadow based account check of sudo.
#
# Molecule connects as root and only calls sudo to drop to a service account,
# for instance `become_user: pdns`. On the CI hosts the account phase of
# pam_unix cannot retrieve the shadow data of the local accounts of these images
# and aborts sudo with "PAM account management error: Authentication service
# cannot retrieve authentication info". pam_localuser approves any account that
# exists in /etc/passwd, which covers every user sudo can set as PAM_USER here:
# the invoking user, root and the service account.
#
# Only the account phase of sudo is short-circuited. Authentication, password
# and session handling, the shared system-auth stack and the sudoers policy are
# untouched, and accounts that do not exist locally are still rejected.
RUN sed -i '0,/^account/s//account    sufficient   pam_localuser.so\naccount/' /etc/pam.d/sudo

# Create `ansible` user with sudo permissions
ENV ANSIBLE_USER=ansible SUDO_GROUP=wheel
RUN set -xe && \
    groupadd -r ${ANSIBLE_USER} && \
    useradd -m -g ${ANSIBLE_USER} ${ANSIBLE_USER} && \
    usermod -aG ${SUDO_GROUP} ${ANSIBLE_USER} && \
    sed -i "/^%${SUDO_GROUP}/s/ALL\$/NOPASSWD:ALL/g" /etc/sudoers

VOLUME [ "/sys/fs/cgroup", "/tmp", "/run" ]

CMD [ "/usr/sbin/init" ]
